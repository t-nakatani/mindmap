{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindmap",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // ページ（index.html と favicon.svg）は静的アセットとして配る。/api/ は Worker が受ける。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // 全マップと「今選んでいるマップ」を持つ Durable Object。インスタンスは1つだけ使う。
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "MindmapStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MindmapStore"] }],
  // Google のクライアント・通すメールアドレス・API トークンは secret で入れる（src/env.d.ts、.dev.vars.example）。
  "observability": { "enabled": true }
}
